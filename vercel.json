{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{ML/**,frontend/**,.venv/**,**/__pycache__/**,**/test_*.py,*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/index/predict"
    },
    {
      "source": "/health",
      "destination": "/api/index/health"
    },
    {
      "source": "/docs",
      "destination": "/api/index/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index/openapi.json"
    }
  ]
}