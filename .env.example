# Google Gemini API Configuration (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=ur key

# Tavily Search API Configuration (Required)
# Get your API key from: https://tavily.com
# Free tier: 1,000 queries/month
TAVILY_API_KEY=ur key

# OpenAQ API Configuration (Optional but Recommended)
# Get your API key from: https://openaq.org/
# Provides real air quality sensor data for better accuracy
OPENAQ_API_KEY=ur key

# Logging
LOG_LEVEL=INFO
