# ============================================
# AgenticWeatherAI - Environment Configuration
# ============================================

# Google Gemini API Configuration (REQUIRED)
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for: Natural language summaries and health recommendations
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Configuration (REQUIRED)
# Get your API key from: https://tavily.com
# Free tier: 1,000 queries/month
# Used for: Environmental news, context, and AQI fallback
TAVILY_API_KEY=your_tavily_api_key_here

# World Air Quality Index (WAQI) API Configuration (REQUIRED - PRIMARY DATA SOURCE)
# Get your API key from: https://aqicn.org/data-platform/token/
# Free tier: 1,000 requests/minute
# Coverage: 12,000+ monitoring stations worldwide
# Used for: Real-time AQI, PM2.5, PM10, O3, NO2, SO2, CO, weather data
# Demo token included below (replace with your own for production)
WAQI_API_KEY=7616cb77c13b13fd483b76c94ae8ba422dc94e8c
WAQI_TOKEN=7616cb77c13b13fd483b76c94ae8ba422dc94e8c

# Logging Configuration (Optional)
LOG_LEVEL=INFO

# ============================================
# Data Source Priority:
# 1. WAQI API (Primary) - Real-time sensor data
# 2. Tavily Search (Fallback) - Extract AQI from web if WAQI fails
# 3. Cache (Last resort) - Use cached data if both fail
# ============================================
